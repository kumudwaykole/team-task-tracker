// Prisma schema: https://pris.ly/d/prisma-schema
// CHECK constraints that Prisma cannot express live in the init migration SQL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}

enum WorkItemType {
  TASK
  TICKET
}

// One enum for both types. Which values are valid for which type is
// enforced by the `status_matches_type` CHECK constraint.
enum Status {
  TODO
  OPEN
  IN_PROGRESS
  IN_REVIEW
  ESCALATED
  RESOLVED
  CLOSED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  ASSIGNED
  STATUS_CHANGED
  COMMENTED
  TICKET_CREATED
  DUE_SOON
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  managedProjects Project[]       @relation("ProjectManager")
  memberships     ProjectMember[]
  requestedItems  WorkItem[]      @relation("Requester")
  assignedItems   WorkItem[]      @relation("Assignee")
  comments        Comment[]
  notifications   Notification[]
}

model Project {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(120)
  managerId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  manager   User            @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)
  members   ProjectMember[]
  workItems WorkItem[]

  // Also serves as the index for "projects managed by X".
  @@unique([managerId, name])
}

model ProjectMember {
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  addedAt   DateTime @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model WorkItem {
  id          String       @id @default(uuid(7)) @db.Uuid
  type        WorkItemType
  title       String       @db.VarChar(200)
  description String
  status      Status
  priority    Priority     @default(MEDIUM)
  projectId   String?      @db.Uuid
  requesterId String       @db.Uuid
  assigneeId  String?      @db.Uuid
  dueDate     DateTime?    @db.Timestamptz(3)
  remindedAt  DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requester User     @relation("Requester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee  User?    @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments      Comment[]
  notifications Notification[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([requesterId])
  @@index([type, priority])
  @@index([dueDate])
  @@index([createdAt, id])
}

model Comment {
  id         String   @id @default(uuid(7)) @db.Uuid
  workItemId String   @db.Uuid
  userId     String   @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workItemId, createdAt])
  @@index([userId])
}

model Notification {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @db.Uuid
  type       NotificationType
  workItemId String?          @db.Uuid
  message    String           @db.VarChar(500)
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt]) // unread count + unread list
  @@index([userId, createdAt]) // full history, newest first
  @@index([workItemId]) // cascade delete from WorkItem
}
