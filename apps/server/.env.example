# Database (start it with: docker compose up -d db). Host port 5434 maps to Postgres in Docker.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/tracker?schema=public"

# Server
PORT=3000
NODE_ENV=development
# Allowed CORS origins, comma separated.
CLIENT_URL="http://localhost:3000,http://localhost:5173"

# Auth
# At least 32 random characters. `pnpm bootstrap` generates one when it creates .env.
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="1d"
BCRYPT_ROUNDS=12

# Reverse proxy hops in front of the app (1 behind Caddy or Nginx); 0 when there is none
TRUST_PROXY=0

# Background jobs (set RUN_JOBS=false to disable, e.g. on extra instances)
RUN_JOBS=true
DUE_SOON_CRON="*/15 * * * *"
DUE_SOON_WINDOW_HOURS=24
NOTIFICATION_RETENTION_DAYS=90

# React app, relative to apps/server (dev: served through Vite, production: the built files)
WEB_DIR="../web"
WEB_DIST_DIR="../web/dist"
