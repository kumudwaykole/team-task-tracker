# Loaded by vitest.config.ts. Variables that are already set (e.g. by CI) win.
# The database name must contain "_test": the test setup refuses anything else, and it
# creates the database and applies the migrations on its own.
NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/tracker_test?schema=public"
JWT_SECRET="test-secret-test-secret-test-secret-123456"
JWT_EXPIRES_IN="1d"
BCRYPT_ROUNDS=4
RUN_JOBS=false
DUE_SOON_WINDOW_HOURS=24
NOTIFICATION_RETENTION_DAYS=90
