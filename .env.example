# Settings for Docker Compose (docker compose reads .env in this folder). Copy to .env.
# Local development without Docker for the app uses apps/server/.env instead.

# Database container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tracker

# Host ports. Change them if they are taken. (DB_PORT must match DATABASE_URL in apps/server/.env.)
APP_PORT=3000
DB_PORT=5434

# Required, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d

# Public URL of the app (allowed CORS origin)
CLIENT_URL=http://localhost:3000

# true loads the demo users and sample data on start (anything that already exists is skipped).
# NEVER true on a real deployment.
SEED=true

# Hosting behind Caddy (--profile prod): your domain, and 1 proxy hop for correct client IPs.
DOMAIN=localhost
TRUST_PROXY=0
