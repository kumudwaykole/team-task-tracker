{
  "name": "task-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Team Task & Support Ticket Tracker",
  "scripts": {
    "setup": "pnpm bootstrap",
    "bootstrap": "pnpm install && node scripts/bootstrap.mjs",
    "dev": "docker compose up -d --wait db && pnpm --filter server dev",
    "build": "pnpm --filter web build && pnpm --filter server build",
    "start": "pnpm --filter server start",
    "test": "pnpm --filter server test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "docker:up": "docker compose --profile app up --build",
    "docker:down": "docker compose --profile app down",
    "docker:reset": "docker compose --profile app down -v",
    "docker:seed": "docker compose --profile app run --rm migrate pnpm --filter server db:seed"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.34.4",
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
