      "key": "projectId",
      "value": ""
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "workItemId",
      "value": ""
    },
    {
      "key": "dueDate",
      "value": ""
    }
  ],
