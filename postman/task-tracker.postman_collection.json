        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const value = body.success ? body.data.token : undefined;",
                  "if (value) pm.collectionVariables.set('token', value);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "description": "Logs in as admin@tracker.dev and stores the token for every other request.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
